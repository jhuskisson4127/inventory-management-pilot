# Local MySQL 8 connection is set by docker-compose.yml. For a hosted MySQL 8 service, set:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4
# To migrate from the old local PostgreSQL volume, leave SOURCE_DATABASE_URL unset;
# docker-compose supplies its temporary legacy Postgres connection during migration.
# SESSION_COOKIE_SECURE defaults to true. Local Compose sets false for localhost HTTP.
